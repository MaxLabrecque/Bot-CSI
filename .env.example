# Required
BOT_TOKEN=""
CLIENT_ID=""
LOG_CHANNEL_ID=""

# Optional
# Register slash commands on one server only (instant update, useful for dev)
GUILD_ID=""
# Team channels: <prefix>XX (2 digits) + extra names, comma separated
TEAM_CHANNEL_PREFIX="equipe-"
TEAM_CHANNEL_EXTRA="test"
# Role allowed to use moderator commands (case-insensitive)
MODERATOR_ROLE="moderator"
# SQLite database file
DB_PATH="db/bot.sqlite"
# Role pinged for tickets waiting too long (default: MODERATOR_ROLE)
ADMIN_ROLE=""
# Ping ADMIN_ROLE when a ticket is still open after X minutes
TICKET_STALE_MINUTES="5"
